# PostgreSQL connection (used by Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/campus_mess?schema=public"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Admin signup access code (students don't need this; admins enter it on signup)
ADMIN_ACCESS_CODE="MESS2026"

# Server
PORT=5000

# Used to build the password reset link. Change if your frontend runs elsewhere.
FRONTEND_URL="http://localhost:5173"

# Email (used to send real password reset emails via Gmail SMTP)
# Leave these blank to skip real email and fall back to showing the reset
# link on screen instead. See README.md for how to generate an App Password.
EMAIL_USER=""
EMAIL_PASS=""
